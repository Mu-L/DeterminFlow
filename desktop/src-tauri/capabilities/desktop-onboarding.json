{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-onboarding",
  "description": "Allow the bundled loopback UI to persist first-run onboarding state.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*"]
  },
  "permissions": [
    "allow-get-desktop-onboarding-status",
    "allow-set-desktop-onboarding-status"
  ]
}
